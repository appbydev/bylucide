{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "noEmit": true,
    "types": ["bun"], "noUncheckedIndexedAccess": true
  },
  "include": ["src", "scripts"]
}
